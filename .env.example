# Linux container only; read-only metadata inspection, never deletion authorization.
FS_INSPECTION_ENABLED=false
NAS_INSPECTION_ENABLED=false

# Deletion is intentionally disabled by default. Enabling it allows anyone
# who can reach the app from the configured origin to initiate deletion.
MOVIE_DELETION_ENABLED=false
SERIES_DELETION_ENABLED=false
APP_ORIGIN=http://localhost:3000
DELETE_STATE_DIR=
